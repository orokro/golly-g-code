{
	"name": "gollygcode",
	"productName": "GollyGCode",
	"version": "0.1.0",
	"description": "A local-first SVG to G-code CAM application for hobby CNC routers.",
	"license": "MIT",
	"type": "module",
	"main": "src/main/main.cjs",
	"scripts": {
		"dev": "node scripts/dev-server.js",
		"build": "node scripts/build.js && electron-builder",
		"build:win": "node scripts/build.js && electron-builder --win",
		"build:mac": "node scripts/build.js && electron-builder --mac",
		"build:linux": "node scripts/build.js && electron-builder --linux",
		"lab": "vite --config vite.lab.config.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.12",
		"clipper2-ts": "2.0.1",
		"svgpath": "^2.6.0",
		"valibot": "^1.4.2",
		"vue": "^3.5.41",
		"vue-settings-panel": "^0.0.5",
		"vue-win-mgr": "file:../Vue-Window-Manager"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/test-utils": "^2.4.11",
		"chalk": "^6.0.0",
		"chokidar": "^5.0.0",
		"electron": "^44.0.0",
		"electron-builder": "^26.15.3",
		"eslint": "^10.9.1",
		"eslint-plugin-jsdoc": "^64.2.1",
		"eslint-plugin-vue": "^10.10.0",
		"globals": "^17.11.0",
		"jsdom": "^28.0.0",
		"sass": "^1.103.1",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
